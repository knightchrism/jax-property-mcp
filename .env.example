# Copy to .env (gitignored). Same PostGIS database built by jax-property-intelligence.
# The MCP server only needs READ access: use the SELECT-only jax_reader role created by sql/roles.sql,
# never the postgres superuser.
DB_USER=jax_reader
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jax_property
# The loader scripts (load_flood.py, load_sales.py, clean_addresses.py, home_types.py) rebuild tables and must run
# as jax_loader. Real environment variables override .env, e.g.:
#   DB_USER=jax_loader DB_PASSWORD=... python load_sales.py
